  <folder name="Application" id="id-64604142156a4a6a8bb7b2925e73d65c" type="application"/>
  <folder name="Technology &amp; Physical" id="id-b62fdd6d62224316bf1af3d69c5f96ed" type="technology"/>
  <folder name="Motivation" id="id-715249502f884367abe61023fabfb405" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Dono da software house" id="id-d8b1a745f6d7490d84808e729908381b"/>
    <element xsi:type="archimate:Driver" name="Acabar com a informalidade no atendimento do suporte" id="id-f08eaf61620b44a08ae329206ce2d6f0"/>
    <element xsi:type="archimate:Driver" name="Ter controle gerencial sobre os resultados dos serviços de suporte" id="id-d5027d9cddeb4a0fad60b7975ad448d5"/>
    <element xsi:type="archimate:Principle" name="Registrar o tempo de atendimento ao longo do processo de suporte" id="id-c07925c46c9f4df09a16add86d52871a"/>
    <element xsi:type="archimate:Principle" name="Conhecer o nível de satisfação de todos os clientes" id="id-3d4cdf2276a54dde9527b711095d4e0d"/>
    <element xsi:type="archimate:Goal" name="Criar um processo padronizado de atendimento de chamados técnicos do registro à solução" id="id-bc4094f673aa4f7d93962d829051ef06"/>
    <element xsi:type="archimate:Assessment" name="Implementar um sistema de workflow digital" id="id-895b3912704f4d46b59379a999637535"/>
    <element xsi:type="archimate:Assessment" name="Utilizar Bot como acelerador de atendimento, sendo o canal único de abertura de chamado" id="id-3b3356e97e1d400abb863ff23c6fc37c"/>
    <element xsi:type="archimate:Goal" name="Criar um mecanismo de feedback com o cliente" id="id-7514fc91fee4428baa0d982521ab1158"/>
    <element xsi:type="archimate:Goal" name="Gerar métricas de acompanhamento e controle de performance de atendimento" id="id-c8fe0936c1944caf94a2cede46c7b211"/>
    <element xsi:type="archimate:Assessment" name="Mensagem de avaliação do cliente solicitada por: email integrado a aplicação de workflow" id="id-f0845a6196784cc586c712b16b9b6cb8"/>
    <element xsi:type="archimate:Assessment" name="Utilizar o sistema de Business Inteligence já existente na empresa, acessando os dados do suporte" id="id-3d324f268a6a44ac86fc7b1fd4ca421a"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-50f33fb61efa4189bc4b882bf65989ea"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-de4c76e555314cf0bc0a8e32dbfeb6e1"/>
    <element xsi:type="archimate:Outcome" name="O sistema de workflow chamado deve estar disponível e acessível no horário de funcionamento do suporte (8h as 18h) de segunda a sexta" id="id-2ed8abaad4054b58830bfd5bc703dc1f"/>
    <element xsi:type="archimate:Goal" name="Todo chamado solucionado deve ter uma pesquisa de satisfação disparada/enviada" id="id-d053bf0a714c47a3841e0078c466c147"/>
    <element xsi:type="archimate:Outcome" name="Os dados para consulta estarão disponíveis em D+1 (dia seguinte ao fato gerador)" id="id-7ab4bf84c3b9462cadb459d404c1fe7c"/>
    <element xsi:type="archimate:Requirement" name="Registrar novo chamado" id="id-5d4d1a4e2d2d46f89d9b9e626a6a0a29"/>
    <element xsi:type="archimate:Requirement" name="Registrar movimentação do chamado" id="id-0ca8ba9941dc47318f1b62d8cd1c411b"/>
    <element xsi:type="archimate:Requirement" name="Enviar pesquisa de satisfação" id="id-dbb6959a0c3142d4b85451480e3e60d0"/>
    <element xsi:type="archimate:Requirement" name="Computar respostas de pesquisas" id="id-852451ed657b4abda22483282a3c2cd3"/>
    <element xsi:type="archimate:Requirement" name="Carga de dados do sistema transacional de controle de chamados para o BI" id="id-59ebc4a1f5924a01872d54fca85433b7"/>
    <element xsi:type="archimate:Constraint" name="Informar a identificação da empresa do cliente, nome da pessoa demandante, telefone e email de contato e descrição do problema. O sistema vai gerar um protocolo de identificação do chamado e associar também a data e hora de registro e o status de pendente. Somente serão registrados chamados de clientes com contrato de suporte" id="id-5681ebef1d29444096e36252e867529e"/>
    <element xsi:type="archimate:Constraint" name="Selecionar um chamado da fila de atendimento com status pendente, obedecendo a ordem de registro. Deve ser formada a ação realizada para tentar solucionar a ocorrência e registrar o resultado obtido, gerando um LOG com a identificação com o analista de suporte, a identificação do chamado, a descrição da ação e resultado e a data e hora da operação. Se o chamado for resolvido, o status deve ser atualizado para solucionado e a pesquisa de satisfação deve ser enviada ao cliente" id="id-b18db87d38084600870a68da72032cc7"/>
    <element xsi:type="archimate:Constraint" name="Quando o chamado for solucionado, uma pesquisa de satisfação será enviada contendo: Identificação do chamado, Identificação do Ptoblema Original, Descrição da Solução e uma lista de critérios para pontuação pré-definida (notas a escolher)." id="id-0ad559ce72fd4ed08afb0092143503bc"/>
    <element xsi:type="archimate:Requirement" name="Carga de dados do sistema transacional de controle de chamados para o BI (copy)" id="id-7654a28c4eca4018b4655a191c5768da"/>
    <element xsi:type="archimate:Constraint" name="Durante a madrugada sera executada uma aplicação de extração, transformarção e carga de dados (ETL) que vai selecionar dados do sistema transacional de controle de chamados e alimenta um banco de dados específico para contas no BI" id="id-ecef2e22c8ec447cac21bfbc089c86cf"/>
    <element xsi:type="archimate:Constraint" name="Quando chegar uma resposta da caixa postal das pesquisas, os dados de avaliação devem ser guardados vinculados com o chamado que foi avaliado" id="id-99201e1dd8674a0eb458ef80aa98a270"/>
  </folder>
